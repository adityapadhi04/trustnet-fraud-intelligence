# ==============================================================================
# TRUSTNET - Environment Configuration Example
# Copy this file to '.env' and fill in your actual settings.
# Do NOT commit the '.env' file containing real secrets to Git.
# ==============================================================================

# Application Environment (development, testing, production)
ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security and Cryptography
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=trustnet_db
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/trustnet_db

# React Frontend configuration (for development reference)
REACT_APP_API_URL=http://localhost:8000
